# 1Password secret references: op run --env-file .env.1password -- <command> が環境変数として渡す。
# 値は書かない。op://<vault>/<item>/<field> の参照だけを書く。
GITHUB_OAUTH_CLIENT_ID=op://star-kojiki/GITHUB_OAUTH_CLIENT_ID/password
GITHUB_OAUTH_CLIENT_SECRET=op://star-kojiki/GITHUB_OAUTH_CLIENT_SECRET/password
GITHUB_PERSONAL_ACCESS_TOKEN=op://star-kojiki/GITHUB_PERSONAL_ACCESS_TOKEN/password
